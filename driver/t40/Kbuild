tx-isp-t40-objs := tx_isp_t40_recovered.o \
		   tx_isp_t40_frame_layout.o \
		   tx_isp_t40_tuning_abi.o \
		   tx_isp_t40_sinfo.o \
		   tx_isp_t40_subdev.o
tx-isp-t40-$(CONFIG_TX_ISP_T40_V4L2) += tx_isp_t40_video_queue.o \
		   tx_isp_t40_v4l2.o
obj-m += tx-isp-t40.o

ccflags-y += -I$(src)/../include
ccflags-y += -DREGTRACE_KERNEL_TREE_BUILD

# Per-frame load statistics (ISR bit counters, work run times), off for
# release builds: make ... TX_ISP_LOAD_STATS=y
ifeq ($(TX_ISP_LOAD_STATS),y)
ccflags-y += -DTX_ISP_LOAD_STATS
endif
# /dev/tisp parameter get/set commands (generic read/write of the module parameter blocks and ISP
# registers, #164).  Debug only, default off: make ... TX_ISP_T40_TISP_PAR=y, then insmod t40_tisp_par=1;
# every call needs CAP_SYS_RAWIO.  Needed by the apitest case tisppar_t40 only.
ifeq ($(TX_ISP_T40_TISP_PAR),y)
ccflags-y += -DTX_ISP_T40_TISP_PAR
endif
ccflags-$(CONFIG_TX_ISP_T40_V4L2) += -DCONFIG_TX_ISP_T40_V4L2
# -Os like the other SoCs (kernel default) instead of the old bring-up
# -O0 -fno-tree-dce -fno-ipa-pure-const -fno-ipa-reference.  TX_ISP_T40_O0=y
# restores that build for A/B if the recovered code misbehaves when optimised.
TX_ISP_T40_O0 ?= n
ifeq ($(TX_ISP_T40_O0),y)
ccflags-y += -O0 -fno-tree-dce -fno-ipa-pure-const -fno-ipa-reference
endif
ccflags-y += -std=gnu99 -w
ccflags-y += -Wno-error=strict-prototypes
ccflags-y += -Wno-error=int-conversion
ccflags-y += -Wno-error=incompatible-pointer-types
ccflags-y += -Wno-error=implicit-function-declaration

# Rootfs size: no .pdr (procedure descriptors, never loaded by the kernel).
ccflags-y += $(call cc-option,-Wa$(comma)-mno-pdr)

# Rootfs size: address static data through section anchors (one lui/addiu
# per block instead of a HI16/LO16 pair per object); halves .rel.text.
ccflags-y += -fsection-anchors

# Rootfs size: drop local (static) symbols from the module image. The kernel
# resolves exports through __ksymtab, so .symtab/.strtab bulk is dead weight.
LDFLAGS_MODULE += -x

# Rootfs size: per-function sections + --gc-sections drop code nothing
# references (recovered-but-unused helpers); driver/tx_isp_merge.lds keeps the
# module-loader sections and folds the rest back (same as T31/T41).
# TX_ISP_GC=n builds the old layout.
TX_ISP_GC ?= y
ifneq ($(TX_ISP_GC),n)
ccflags-y += -ffunction-sections
LDFLAGS_MODULE += --gc-sections --undefined=init_module --undefined=cleanup_module \
	-T $(abspath $(src)/../tx_isp_merge.lds)
endif

# Rootfs size: bring-up-only parameters (see docs/SIZE.md) and the legacy
# /proc/tx_isp_t40_recovered debug file (register dump, "exit N", "dumplog")
# are built in only on request:
#   make ... TX_ISP_T40_BRINGUP_PARAMS=y TX_ISP_T40_DEBUG_PROC=y
TX_ISP_T40_BRINGUP_PARAMS ?= n
ifeq ($(TX_ISP_T40_BRINGUP_PARAMS),y)
ccflags-y += -DTX_ISP_T40_BRINGUP_PARAMS
endif
TX_ISP_T40_DEBUG_PROC ?= n
ifeq ($(TX_ISP_T40_DEBUG_PROC),y)
ccflags-y += -DTX_ISP_T40_DEBUG_PROC
endif
