obj-m += tx-isp-t20.o
tx-isp-t20-objs := \
	sdk/tx-isp-vic.o \
	sdk/tx-isp-videobuf.o \
	sdk/tx-isp-video-in.o \
	sdk/tx-isp-frame-channel.o \
	sdk/tx-isp-csi.o \
	sdk/tx-isp-interrupt.o \
	sdk/tx-isp-debug.o \
	sdk/tx-isp-device.o \
	sdk/tx-isp-core-tuning.o \
	sdk/tx-isp-core.o \
	sdk/apical-dynamic-calibrations.o \
	sdk/apical-static-calibrations.o \
	sdk/apical-calibrations.o \
	sdk/apical-calibrations-init.o \
	sdk/tx-isp-load-parameters.o \
	sdk/apical-custom-initialization.o \
	sdk/ApicalDefault.o \
	sdk/system-isp-io.o \
	sdk/log.o \
	sdk/system-io.o \
	sdk/system-i2c.o \
	sdk/system-spi.o \
	sdk/system-timer.o \
	sdk/system-uart.o \
	sdk/system-semaphore.o \
	sdk/sensor-drv.o \
	tx_isp_t20_sinfo.o \
	tx_isp_t20_math.o \
	tx_isp_t20_firmware.o

ccflags-y += -DREGTRACE_KERNEL_TREE_BUILD

# Per-frame load statistics (ISR bit counters, work run times), off for
# release builds: make ... TX_ISP_LOAD_STATS=y
ifeq ($(TX_ISP_LOAD_STATS),y)
ccflags-y += -DTX_ISP_LOAD_STATS
endif

# Bring-up traces (t20_trace, t20_runtime_trace, t20_trace_events) are compiled out by
# default since 2026-11-06 (about -10 KiB module RAM, -15 KiB .ko; nothing
# in OpenIMP, the streamer, the tools or /etc/modules.d sets them; note that the
# 3.10 kernel refuses an unknown module parameter).  TX_ISP_TRACE=y builds
# them in for bring-up work.
TX_ISP_TRACE ?= n
ifneq ($(TX_ISP_TRACE),y)
ccflags-y += -DTX_ISP_NO_TRACE
endif

# Reproducible builds: __FILE__ in the SDK log macros is shortened to a
# path relative to the repository, so the module does not depend on the
# directory it is built in.
ccflags-y += -fmacro-prefix-map=$(abspath $(src)/../..)/=
ccflags-y += -DCONFIG_ISP_MODULE_USE_MMAP
ccflags-y += -I$(src)/../include
ccflags-y += -I$(src)/sdk/source/apical-isp
ccflags-y += -I$(src)/../../external/ingenic-sdk/include
ccflags-y += -I$(src)/../../external/ingenic-sdk/3.10.14/isp/t20
ccflags-y += -I$(src)/../../external/ingenic-sdk/3.10.14/isp/t20/apical-isp
ccflags-y += -I$(src)/../../external/ingenic-sdk/3.10.14/isp/t20/include
ccflags-y += -I$(src)/../../external/ingenic-sdk/3.10.14/sensor-src/include
# memory: all units build at the kernel default (-Os).  The recovered
# firmware unit (driver/t20/tx_isp_t20_firmware.c) used to need -O0; the
# spots that relied on it are fixed and tests/t20_fw checks -O0 vs -Os
# equivalence on the host.  TX_ISP_FW_O0=1 restores the old -O0 build
# (A/B device tests).
ifeq ($(TX_ISP_FW_O0),1)
CFLAGS_tx_isp_t20_firmware.o += -O0 -fno-tree-dce -fno-ipa-pure-const -fno-ipa-reference
endif
ccflags-y += -std=gnu99 -fpermissive -w
ccflags-y += -Wno-error=strict-prototypes
ccflags-y += -Wno-error=implicit-function-declaration
ccflags-y += -Wno-error=implicit-int
ccflags-y += -Wno-error=int-conversion
ccflags-y += -Wno-error=incompatible-pointer-types

# Rootfs size: no .pdr (procedure descriptors, never loaded by the kernel).
ccflags-y += $(call cc-option,-Wa$(comma)-mno-pdr)

# Rootfs size: drop local (static) symbols from the module image. The kernel
# resolves exports through __ksymtab, so .symtab/.strtab bulk is dead weight.
LDFLAGS_MODULE += -x

# Rootfs size: address static data through section anchors (one lui/addiu
# per block instead of a HI16/LO16 pair per object).  Anchors also reorder
# the static data of a unit, so the recovered firmware unit keeps the plain
# layout it was verified with (tests/t20_fw); TX_ISP_FW_ANCHORS=y includes it.
ccflags-y += -fsection-anchors
ifneq ($(TX_ISP_FW_ANCHORS),y)
CFLAGS_REMOVE_tx_isp_t20_firmware.o += -fsection-anchors
endif

# Rootfs size: per-function sections + --gc-sections drop code nothing
# references; driver/tx_isp_merge.lds KEEPs the module-loader sections and
# folds the per-function sections back into .text (as on T21/T23/T31/T41).
# TX_ISP_GC=n builds the old layout.
TX_ISP_GC ?= y
ifneq ($(TX_ISP_GC),n)
ccflags-y += -ffunction-sections
LDFLAGS_MODULE += --gc-sections --undefined=init_module --undefined=cleanup_module \
	-T $(abspath $(src)/../tx_isp_merge.lds)
# Units whose only unused data are the format strings of functions the GC
# already drops (register dumps, I2C/sensor-reset helpers, log level table):
# per-object data sections (CFLAGS_<basename>.o: kbuild keys per-file flags
# by the base name, not the sdk/ path) let the GC drop those strings too.
# Not module-wide: -fdata-sections disables -fsection-anchors and grows
# .text/.rel.text elsewhere.  Same set as driver/t10/Kbuild.
CFLAGS_tx-isp-vic.o += -fdata-sections
CFLAGS_tx-isp-csi.o += -fdata-sections
CFLAGS_system-isp-io.o += -fdata-sections
CFLAGS_system-i2c.o += -fdata-sections
CFLAGS_log.o += -fdata-sections
endif

# Not linked: sdk/system-chardev.o (Apical control-tool char device).
# Nothing calls system_chardev_*() (the firmware only declares them) and
# --gc-sections already dropped all of its code; only its two 4 KiB kfifos
# (.bss) and the misc device stayed.  Same as driver/t10/Kbuild.
