ccflags-y += -I$(src)/include -I$(src)/../include
ccflags-y += -include $(src)/include/tx_isp_kernel_compat.h

# The vendor 5.15 tree still builds with -std=gnu89 but the driver uses C99
# declarations in for-loops; the vendor kernel also lacks CONFIG_SET_FS and
# other mainline-only APIs (see tx_isp_kernel_compat.h).
ifdef TX_ISP_VENDOR_TREE
ccflags-y += -DTX_ISP_VENDOR_TREE -std=gnu99
endif

ccflags-y += -Wno-error=incompatible-pointer-types -Wno-error=strict-prototypes

# Per-frame load statistics (ISR bit counters, work run times), off for
# release builds: make ... TX_ISP_LOAD_STATS=y
ifeq ($(TX_ISP_LOAD_STATS),y)
ccflags-y += -DTX_ISP_LOAD_STATS
endif

# TX_ISP_T31_TRACE=y keeps the bring-up trace (pr_info, off at run time
# unless t31_runtime_trace=1) in the module; n drops it and its strings.
TX_ISP_T31_TRACE ?= n
ifneq ($(TX_ISP_T31_TRACE),y)
ccflags-y += -DTX_ISP_T31_NO_TRACE
endif

# Main ISP module objects - note changed name to tx-isp-t31 (ensure tx_isp_module.o is first)
tx-isp-t31-objs := tx_isp_module.o \
               tx_isp_core.o \
               tx_isp_reset.o \
               tx_isp_subdev.o \
               tx_isp_proc.o \
               tx_isp_sysfs.o \
               tx_isp_vic.o \
               tx_isp_vic_debug.o \
               tx_isp_frame_done.o \
               tx_isp_csi.o \
               tx_isp_fs.o \
               tx_isp_tuning.o \
               tx_isp_fixpt.o \
               tx_isp_ae_zone.o \
               tx_isp_subdev_mgmt.o \
               tx_isp_t31_subdev_resolver.o \
               tx_isp_sinfo.o \
               tx_isp_daynight.o \
               tx_isp_callback_plan.o \
               tx_isp_reg_profile.o \
               tx_isp_frame_layout.o \
               tx_isp_t31_exposure.o \
	       tx_isp_t31_mdns.o \
	       tx_isp_t31_adr.o \
	       tx_isp_t31_sensor_policy.o \
               tx_isp_tuning_abi.o \
               tx_isp_vin.o

# Mainline V4L2 sensor bridge: kernel >= 5.0 only (3.10/4.4 builds unchanged).
ifeq ($(shell [ $(VERSION) -ge 5 ] && echo y),y)
tx-isp-t31-objs += tx_isp_v4l2_sensor.o
endif
tx-isp-t31-$(CONFIG_TX_ISP_T31_V4L2) += tx_isp_v4l2.o

# Size: export only what sensors and other modules import (whitelist in
# tx_isp_t31_exports.h, from driver/isp_imports.txt); the other exported
# functions become unreferenced and --gc-sections drops them.  The check
# fails the build when a known importer needs a symbol the module lacks.
# TX_ISP_T31_EXPORT_ALL=y builds the old full export table.
TX_ISP_T31_EXPORT_ALL ?= n
ifneq ($(TX_ISP_T31_EXPORT_ALL),y)
ccflags-y += -DTX_ISP_T31_EXPORT_WHITELIST
tx-isp-t31-objs += tx_isp_t31_exports.o
CFLAGS_tx_isp_t31_exports.o += -DTX_ISP_T31_EXPORTS_C
endif
always += tx_isp_t31_exports.checked
clean-files += tx_isp_t31_exports.checked
$(obj)/tx_isp_t31_exports.checked: $(obj)/tx-isp-t31.o $(src)/../isp_imports.txt \
		$(src)/../../tests/check_isp_exports.sh
	$(Q)$(CONFIG_SHELL) $(src)/../../tests/check_isp_exports.sh t31 $(obj)/tx-isp-t31.o \
		$(CROSS_COMPILE)readelf $(src)/../isp_imports.txt
	$(Q)touch $@
ccflags-$(CONFIG_TX_ISP_T31_V4L2) += -DCONFIG_TX_ISP_T31_V4L2

# Build both modules - changed tx-isp.o to tx-isp-t31.o
obj-m := tx-isp-t31.o

# Rootfs size: no .pdr (procedure descriptors, never loaded by the kernel).
ccflags-y += $(call cc-option,-Wa$(comma)-mno-pdr)

# Rootfs size: address static data through section anchors (one lui/addiu
# per block instead of a HI16/LO16 pair per object); halves .rel.text.
ccflags-y += -fsection-anchors

# Rootfs size: drop local (static) symbols from the module image. The kernel
# resolves exports through __ksymtab, so .symtab/.strtab bulk is dead weight.
LDFLAGS_MODULE += -x

# Rootfs size: per-function sections + --gc-sections drop code (no -fdata-sections:
# it disables -fsection-anchors and doubles .rel.text) that
# nothing references (recovered-but-unused helpers).  driver/tx_isp_merge.lds
# KEEPs the module-loader-only sections (__ksymtab*, .modinfo, __param, ...) and
# folds the sections back into .text/.data/.bss/.rodata.str1.N afterwards, so
# the .ko does not grow thousands of section headers.  Codegen is unchanged
# (section placement only).  TX_ISP_GC=n builds the old layout.
TX_ISP_GC ?= y
ifneq ($(TX_ISP_GC),n)
ccflags-y += -ffunction-sections
LDFLAGS_MODULE += --gc-sections --undefined=init_module --undefined=cleanup_module \
	-T $(abspath $(src)/../tx_isp_merge.lds)
# -fdata-sections only for the units where it costs (almost) no anchor code
# but lets --gc-sections drop the strings and data of their unused helpers
# (measured on 3.10/gcc 16: -6.4 KiB rodata/data/bss for +0.4 KiB text).
# tx_isp_tuning.o stays without it (+17 KiB text for 2.6 KiB dead data).
TX_ISP_T31_FDS_OBJS := tx_isp_core tx_isp_module tx_isp_subdev tx_isp_csi \
	tx_isp_vic tx_isp_vic_debug tx_isp_vin tx_isp_sysfs tx_isp_subdev_mgmt \
	tx_isp_reset
$(foreach o,$(TX_ISP_T31_FDS_OBJS),$(eval CFLAGS_$(o).o += -fdata-sections))
endif
